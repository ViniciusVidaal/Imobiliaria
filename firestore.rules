rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /properties/{propertyId} { allow read: if true; allow create, update, delete: if request.auth != null; }
    match /imoveis/{propertyId} { allow read: if true; allow create, update, delete: if request.auth != null; }
    match /usuarios/{userId} { allow read, create, update: if request.auth != null; allow delete: if false; }
    match /historico/{entryId} { allow read, create: if request.auth != null; allow update, delete: if false; }
    match /configuracoes/{documentId} { allow read: if request.auth != null; allow write: if false; }
  }
}
